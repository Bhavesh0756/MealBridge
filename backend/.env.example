# MealBridge Backend Environment Variables
SECRET_KEY=mealbridge-super-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Leave empty to use local SQLite fallback)
# For PostgreSQL:
# DATABASE_URL=postgres://mealbridge_user:mealbridge_pass@localhost:5432/mealbridge_db
DATABASE_URL=

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
